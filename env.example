# Example environment file (copy to .env and fill values)

# URL of the FastAPI backend (used by Vercel in production)
BACKEND_URL=https://your-backend.up.railway.app

# Firebase service account credentials (JSON string)
# Get this from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# Convert the JSON file content to a single line string
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"your-project-id",...}

# Admin password (fallback, optional)
ADMIN_PASSWORD=your-secret-password

# Port for local backend development
PORT=8001
