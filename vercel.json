{
  "version": 2,
  "public": "website/public",
  "builds": [
    {
      "src": "website/server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/website/public/robots.txt"
    },
    {
      "source": "/sitemap_blog.xml",
      "destination": "/website/public/sitemap_blog.xml"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "website/server.js"
    }
  ]
}
