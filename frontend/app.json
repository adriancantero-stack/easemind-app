{
  "expo": {
    "name": "EaseMind",
    "slug": "easemind",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icone-app.png",
    "scheme": "easemind",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#C8B6FF",
    "backgroundColor": "#0E1A2B",
    "description": "Ease your mind. Heal your day. Mental health support app for anxiety and stress.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.easemind.app"
    },
    "android": {
      "package": "io.easemind.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icone-app.png",
        "backgroundColor": "#0E1A2B"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icone-easemind.png",
      "name": "EaseMind",
      "shortName": "EaseMind",
      "lang": "pt-BR",
      "scope": "/",
      "startUrl": "/",
      "backgroundColor": "#0E1A2B",
      "themeColor": "#C8B6FF",
      "display": "standalone",
      "orientation": "portrait-primary",
      "description": "Ease your mind. Heal your day. Mental health support app for anxiety and stress.",
      "dir": "auto",
      "preferRelatedApplications": false,
      "dangerous": {
        "permissions": [
          "INTERNET",
          "RECORD_AUDIO"
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E1A2B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_BACKEND_URL": "${EXPO_PUBLIC_BACKEND_URL}"
    }
  }
}
